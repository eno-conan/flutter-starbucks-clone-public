erDiagram
    auth_users ||--o{ star_acquisitions : "user_id"
    auth_users ||--o{ star_aggregations : "user_id"
    auth_users ||--o{ star_usage : "user_id"
    star_rewards_exchange_items ||--o{ star_usage : "exchange_item_id"

    auth_users {
        uuid id PK "ユーザーID (Supabase Auth)"
    }

    star_acquisitions {
        uuid id PK "ID"
        uuid user_id FK "ユーザーID"
        varchar order_id FK "注文ID"
        smallint category "カテゴリ"
        numeric acquired_points "獲得ポイント"
        timestamptz created_at "作成日時"
        timestamptz updated_at "更新日時"
    }

    star_aggregations {
        uuid user_id FK "ユーザーID"
        bpchar target_year_month PK "対象年月"
        numeric total_points "合計ポイント"
        timestamptz expiration_datetime "有効期限"
        timestamptz created_at "作成日時"
        timestamptz updated_at "更新日時"
        boolean expiration_flag "期限切れフラグ"
    }

    star_usage {
        uuid id PK "ID"
        uuid user_id FK "ユーザーID"
        varchar order_id FK "注文ID"
        integer exchange_item_id FK "交換商品ID"
        numeric point_used "使用ポイント"
        timestamptz created_at "作成日時"
        timestamptz updated_at "更新日時"
    }

    star_rewards_exchange_items {
        integer id PK "ID"
        text short_name "短縮名"
        text name "商品名"
        text image_url "画像URL"
        integer points "必要ポイント"
    }

    star_acquisitions_archive {
        uuid id PK "ID"
        uuid user_id "ユーザーID"
        text order_id "注文ID"
        smallint category "カテゴリ"
        numeric acquired_points "獲得ポイント"
        timestamptz created_at "作成日時"
        timestamptz updated_at "更新日時"
        timestamptz archived_at "アーカイブ日時"
    }

    star_usage_archive {
        uuid id PK "ID"
        uuid user_id "ユーザーID"
        varchar order_id "注文ID"
        integer exchange_item_id "交換商品ID"
        numeric point_used "使用ポイント"
        timestamptz created_at "作成日時"
        timestamptz updated_at "更新日時"
        timestamptz archived_at "アーカイブ日時"
    }
