{
  "includeCoAuthoredBy": false,
  "cleanupPeriodDays": 14,
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000"
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Search(**)",
      "Explore(**)",
      "Skill(*)",
      "Bash"
    ],
    "deny": [
      "Bash(rm)",
      "Bash(rmdir)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./secrets/**)",
      "Read(**/key.properties)",
      "Read(**/secrets.properties)",
      "Read(**/service-account.json)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(~/.bashrc)",
      "Read(~/.bash_profile)",
      "Read(~/.bash_login)",
      "Read(~/.profile)",
      "Read(~/.zshrc)",
      "Read(~/.zprofile)",
      "Read(~/.zshenv)",
      "Read(~/.zlogin)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(//etc/profile)",
      "Read(//etc/environment)",
      "Read(//etc/bash.bashrc)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-git-hooks-installed.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-shell-profile-read.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-destructive-git.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-gate-bypass.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/exfil-guard.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/credential-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-shell-profile-read.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/credential-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'file=$(cat | jq -r \".tool_input.file_path // empty\" 2>/dev/null || true); if [[ \"$file\" =~ analysis_options\\.yaml$ ]]; then echo \"{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"PreToolUse\\\",\\\"permissionDecision\\\":\\\"deny\\\",\\\"permissionDecisionReason\\\":\\\"analysis_options.yamlの変更は禁止されています\\\"}}\" && exit 0; fi'"
          },
          {
            "type": "command",
            "command": "bash -c 'file=$(cat | jq -r \".tool_input.file_path // empty\" 2>/dev/null || true); if [[ \"$file\" =~ pubspec\\.yaml$ ]]; then echo \"{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"PreToolUse\\\",\\\"permissionDecision\\\":\\\"ask\\\",\\\"permissionDecisionReason\\\":\\\"pubspec.yamlへの変更です。依存関係の変更を確認してください\\\"}}\" && exit 0; fi'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-tool-use-lint.sh",
            "timeout": 120,
            "statusMessage": "Running lint check..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline-command.sh"
  },
  "plansDirectory": "./plans",
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true
  }
}
